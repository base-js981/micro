# Application Configuration
NODE_ENV=development
PORT=3001

# Database Configuration
# Format: oracle://user:password@host:port/service_name
# For Docker: use service name (oracle)
# For local: use localhost
DATABASE_URL=oracle://micro_app:password@oracle:1521/XEPDB1

# JWT Configuration
JWT_SECRET=change-me-in-production-use-strong-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Kafka Configuration
KAFKA_BROKERS=kafka:29092
KAFKA_CLIENT_ID=auth-service
KAFKA_GROUP_ID=auth-service-group

# gRPC Configuration
GRPC_PORT=50051

# Redis Configuration (optional, for caching)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600

# S3 Configuration (optional, for file storage)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
